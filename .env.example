NODE_ENV=development
PORT=4000
# Matches docker-compose.yml (Postgres on host port 5433). `ezyhotels_test` is
# used by e2e tests (see .env.test). Change the password only if you change it
# in docker-compose.yml too.
DATABASE_URL=postgresql://postgres:password@localhost:5433/ezyhotels
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (Cloudflare R2 in staging).
S3_ENDPOINT=https://b23d713271dd401d24cd18b4f687c12c.r2.cloudflarestorage.com/ezyhotels-staging
S3_BUCKET=ezyhotels-staging
S3_REGION=auto
S3_ACCESS_KEY_ID=replace-with-r2-access-key
S3_SECRET_ACCESS_KEY=replace-with-r2-secret-key
# Public R2 custom domain or public bucket URL used to display uploaded media.
S3_PUBLIC_BASE_URL=

# Payment gateway (Layer C). "sandbox" charges nothing and needs no real keys —
# it signs payments with HMAC-SHA256 (SANDBOX_PAYMENT_SECRET). Pilot swaps this
# to a real provider (e.g. razorpay) + its keys; no caller code changes.
PAYMENT_PROVIDER=sandbox
SANDBOX_PAYMENT_SECRET=change-me-sandbox-hmac-secret-at-least-32-chars

# Comma-separated list of allowed CORS origins. Never use a wildcard in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT secrets - generate distinct, high-entropy values, e.g. `openssl rand -hex 48`
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# OTP pepper and verification-token pepper MUST be distinct values, e.g. `openssl rand -hex 32`
OTP_PEPPER=change-me-otp-pepper-at-least-32-chars
VERIFICATION_TOKEN_PEPPER=change-me-verification-token-pepper-at-least-32-chars

# Field-level encryption: 32-byte AES-256-GCM key as 64-char hex, e.g. `openssl rand -hex 32`
ENCRYPTION_KEY=change-me-64-char-hex-aes-256-key
# HMAC-SHA256 pepper used for deterministic lookup hashes (GSTIN/PAN dedup), e.g. `openssl rand -hex 32`
HMAC_LOOKUP_PEPPER=change-me-hmac-lookup-pepper-at-least-32-chars

# SMS gateway used for OTP delivery (auth) and owner notification SMS (M2).
# Generic HTTP gateway: POST {to, message?|templateId, data?} with Bearer auth.
SMS_GATEWAY_URL=https://your-sms-gateway.example.com/send
SMS_GATEWAY_API_KEY=change-me-sms-gateway-api-key

# Email gateway used for owner notification emails (M2).
# Generic HTTP gateway: POST {to, templateId, data} with Bearer auth.
EMAIL_GATEWAY_URL=https://your-email-gateway.example.com/send
EMAIL_GATEWAY_API_KEY=change-me-email-gateway-api-key

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
